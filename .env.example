# Demo mode: shows the demo bar and lets checkout work without Stripe.
# Set to "false" when you go live.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — use a sk_test_ key first. With a key set, checkout goes through Stripe (even in demo mode).
STRIPE_SECRET_KEY=

# License signing key — generate with `npm run keys`. Required when demo mode is off.
LICENSE_PRIVATE_KEY=

# Where the real installers live (private bucket / CDN). Files: <slug>-<mac|win|linux>.<pkg|exe|tar.gz>
INSTALLER_BASE_URL=
